# Optional. Required only to enable automated SEC EDGAR requests.
# Use a real operator identity as required by SEC automated access policy.
SEC_EDGAR_CONTACT="Your Name your-email@example.com"

# Runtime boundary. Leave as research for the public research build.
# Set to commercial for the provider-free paid/self-hosted build.
ZACHITAN_RUNTIME_MODE=research

# Public-safe conversion URLs for the commercial workspace.
# Use HTTPS onboarding/payment links when available.
# If unset, the application falls back to the zero-cost Tally founding-access form.
NEXT_PUBLIC_ZACHITAN_ONBOARDING_URL=
NEXT_PUBLIC_ZACHITAN_BUNDLE_URL=
